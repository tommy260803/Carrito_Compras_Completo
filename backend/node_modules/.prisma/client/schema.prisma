generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model cat_categorias {
  id         Int              @id @default(autoincrement())
  nombre     String           @unique @db.VarChar(100)
  slug       String           @unique @db.VarChar(120)
  padre_id   Int?
  activo     Boolean          @default(true)
  created_at DateTime         @default(now()) @db.Timestamp
  updated_at DateTime         @default(now()) @updatedAt @db.Timestamp
  productos  cat_productos[]
  padre      cat_categorias?  @relation("CategoriaPadre", fields: [padre_id], references: [id])
  hijos      cat_categorias[] @relation("CategoriaPadre")
}

model cat_productos {
  id                Int       @id @default(autoincrement())
  sku               String    @unique @db.VarChar(50)
  nombre            String    @db.VarChar(200)
  descripcion_corta String?   @db.VarChar(300)
  descripcion_larga String?   @db.Text
  categoria_id      Int
  marca_id          Int?
  unidad_medida_id  Int?
  precio_costo      Decimal   @db.Decimal(12, 2)
  precio_venta      Decimal   @db.Decimal(12, 2)
  precio_oferta     Decimal?  @db.Decimal(12, 2)
  oferta_inicio     DateTime? @db.Date
  oferta_fin        DateTime? @db.Date
  peso              Decimal?  @db.Decimal(10, 2)
  dimensiones       String?   @db.VarChar(100)
  stock_minimo      Int       @default(0)
  activo            Boolean   @default(true)
  created_by        Int?
  updated_by        Int?
  created_at        DateTime  @default(now()) @db.Timestamp
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamp

  categoria     cat_categorias               @relation(fields: [categoria_id], references: [id])
  marca         cat_marcas?                  @relation(fields: [marca_id], references: [id])
  unidad_medida cat_unidades_medida?         @relation(fields: [unidad_medida_id], references: [id])
  imagenes      cat_imagenes_producto[]
  atributos     cat_producto_atributo[]
  items_carrito ord_items_carrito[]
  items_orden   ord_items_orden[]
  stock         inv_stock_producto?
  movimientos   inv_movimientos_inventario[] @relation("MovimientosProducto")
  lista_deseos  cli_lista_deseos_productos[] @relation("ListaDeseosProductos")
  creator       seg_usuarios?                @relation("producto_created", fields: [created_by], references: [id])
  updater       seg_usuarios?                @relation("producto_updated", fields: [updated_by], references: [id])
}

model cat_marcas {
  id         Int             @id @default(autoincrement())
  nombre     String          @unique @db.VarChar(80)
  activo     Boolean         @default(true)
  created_at DateTime        @default(now()) @db.Timestamp
  productos  cat_productos[]
}

model cli_clientes {
  id                       Int       @id @default(autoincrement())
  email                    String    @unique @db.VarChar(100)
  password_hash            String    @db.Text
  nombre                   String    @db.VarChar(80)
  apellido                 String    @db.VarChar(80)
  telefono                 String?   @db.VarChar(20)
  email_verificado         Boolean   @default(false)
  email_verification_token String?   @db.VarChar(255)
  reset_password_token     String?   @db.VarChar(255)
  reset_password_expires   DateTime? @db.Timestamp
  activo                   Boolean   @default(true)
  created_at               DateTime  @default(now()) @db.Timestamp
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamp

  direcciones  cli_direcciones[]
  carritos     ord_carritos[]
  ordenes      ord_ordenes[]
  lista_deseos cli_lista_deseos?
}

model ord_ordenes {
  id                 Int       @id @default(autoincrement())
  codigo             String    @unique @db.VarChar(20)
  cliente_id         Int
  estado_id          Int
  subtotal           Decimal   @db.Decimal(12, 2)
  impuestos          Decimal   @default(0) @db.Decimal(12, 2)
  total              Decimal   @db.Decimal(12, 2)
  direccion_envio_id Int
  metodo_envio_id    Int?
  metodo_pago        String?   @db.VarChar(50)
  pago_referencia    String?   @db.VarChar(100)
  fecha_orden        DateTime  @default(now()) @db.Timestamp
  fecha_pago         DateTime? @db.Timestamp
  fecha_envio        DateTime? @db.Timestamp
  fecha_entrega      DateTime? @db.Timestamp
  notas              String?   @db.Text
  created_at         DateTime  @default(now()) @db.Timestamp
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamp

  cliente           cli_clientes            @relation(fields: [cliente_id], references: [id])
  estado            ord_estados_orden       @relation(fields: [estado_id], references: [id])
  direccion_envio   cli_direcciones         @relation(fields: [direccion_envio_id], references: [id])
  metodo_envio      ord_metodos_envio?      @relation(fields: [metodo_envio_id], references: [id])
  items             ord_items_orden[]
  historial_estados ord_historial_estados[]
  pagos             pag_pagos[]
}

model pag_pagos {
  id             Int      @id @default(autoincrement())
  orden_id       Int
  estado         String   @db.VarChar(20) // pendiente|pagado|fallido|reembolsado
  metodo         String?  @db.VarChar(50)
  monto          Decimal  @db.Decimal(12, 2)
  referencia     String?  @db.VarChar(120)
  transaccion_id String?  @db.VarChar(120)
  created_at     DateTime @default(now()) @db.Timestamp
  updated_at     DateTime @updatedAt @db.Timestamp

  orden ord_ordenes @relation(fields: [orden_id], references: [id], onDelete: Cascade)

  @@index([orden_id])
}

// Resto de modelos (inv_stock_producto, inv_movimientos_inventario, etc.) similar al SQL.
// Por brevedad se continúa con los esenciales.
model seg_usuarios {
  id               Int       @id @default(autoincrement())
  email            String    @unique @db.VarChar(100)
  password_hash    String    @db.Text
  nombre           String?   @db.VarChar(80)
  apellido         String?   @db.VarChar(80)
  telefono         String?   @db.VarChar(20)
  rol_id           Int
  activo           Boolean   @default(true)
  email_verificado Boolean   @default(false)
  reset_token      String?   @db.VarChar(255)
  reset_expires    DateTime? @db.Timestamp
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  rol               seg_roles                    @relation(fields: [rol_id], references: [id])
  productos_created cat_productos[]              @relation("producto_created")
  productos_updated cat_productos[]              @relation("producto_updated")
  ordenes_historial ord_historial_estados[]
  movimientos       inv_movimientos_inventario[]
  refresh_tokens    seg_refresh_tokens[]
}

model seg_roles {
  id          Int               @id @default(autoincrement())
  nombre      String            @unique @db.VarChar(30)
  descripcion String?           @db.Text
  permisos    seg_rol_permiso[]
  usuarios    seg_usuarios[]
}

model seg_permisos {
  id     Int               @id @default(autoincrement())
  modulo String            @db.VarChar(50)
  accion String            @db.VarChar(20)
  roles  seg_rol_permiso[]
}

model seg_rol_permiso {
  rol_id     Int
  permiso_id Int
  rol        seg_roles    @relation(fields: [rol_id], references: [id])
  permiso    seg_permisos @relation(fields: [permiso_id], references: [id])

  @@id([rol_id, permiso_id])
}

model cat_imagenes_producto {
  id          Int      @id @default(autoincrement())
  producto_id Int
  url         String   @db.VarChar(500)
  alt         String?  @db.VarChar(200)
  orden       Int      @default(0)
  created_at  DateTime @default(now()) @db.Timestamp
  updated_at  DateTime @updatedAt @db.Timestamp

  producto cat_productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)
}

model cat_unidades_medida {
  id         Int      @id @default(autoincrement())
  nombre     String   @unique @db.VarChar(50)
  simbolo    String   @db.VarChar(10)
  activo     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp

  productos cat_productos[]
}

model cat_producto_atributo {
  id          Int      @id @default(autoincrement())
  producto_id Int
  nombre      String   @db.VarChar(100)
  valor       String   @db.VarChar(200)
  created_at  DateTime @default(now()) @db.Timestamp

  producto cat_productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)
}

model cli_direcciones {
  id            Int      @id @default(autoincrement())
  cliente_id    Int
  nombre        String   @db.VarChar(100)
  direccion     String   @db.Text
  ciudad        String   @db.VarChar(100)
  provincia     String   @db.VarChar(100)
  codigo_postal String   @db.VarChar(20)
  telefono      String?  @db.VarChar(20)
  es_principal  Boolean  @default(false)
  created_at    DateTime @default(now()) @db.Timestamp
  updated_at    DateTime @updatedAt @db.Timestamp

  cliente cli_clientes  @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  ordenes ord_ordenes[]
}

model cli_lista_deseos {
  id         Int      @id @default(autoincrement())
  cliente_id Int      @unique
  created_at DateTime @default(now()) @db.Timestamp
  updated_at DateTime @updatedAt @db.Timestamp

  cliente   cli_clientes                 @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  productos cli_lista_deseos_productos[]
}

model cli_lista_deseos_productos {
  id          Int      @id @default(autoincrement())
  lista_id    Int
  producto_id Int
  created_at  DateTime @default(now()) @db.Timestamp

  lista    cli_lista_deseos @relation(fields: [lista_id], references: [id], onDelete: Cascade)
  producto cat_productos    @relation("ListaDeseosProductos", fields: [producto_id], references: [id], onDelete: Cascade)

  @@unique([lista_id, producto_id])
}

model ord_carritos {
  id         Int      @id @default(autoincrement())
  cliente_id Int      @unique
  activo     Boolean  @default(true)
  created_at DateTime @default(now()) @db.Timestamp
  updated_at DateTime @updatedAt @db.Timestamp

  cliente cli_clientes        @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  items   ord_items_carrito[]
}

model ord_items_carrito {
  id          Int      @id @default(autoincrement())
  carrito_id  Int
  producto_id Int
  cantidad    Int      @default(1)
  created_at  DateTime @default(now()) @db.Timestamp
  updated_at  DateTime @updatedAt @db.Timestamp

  carrito  ord_carritos  @relation(fields: [carrito_id], references: [id], onDelete: Cascade)
  producto cat_productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)
}

model ord_estados_orden {
  id          Int      @id @default(autoincrement())
  nombre      String   @unique @db.VarChar(50)
  descripcion String?  @db.Text
  color       String?  @db.VarChar(7)
  created_at  DateTime @default(now()) @db.Timestamp

  ordenes   ord_ordenes[]
  historial ord_historial_estados[] @relation("EstadoHistorial")
}

model ord_items_orden {
  id              Int     @id @default(autoincrement())
  orden_id        Int
  producto_id     Int
  cantidad        Int
  precio_unitario Decimal @db.Decimal(12, 2)
  subtotal        Decimal @db.Decimal(12, 2)

  orden    ord_ordenes   @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  producto cat_productos @relation(fields: [producto_id], references: [id])
}

model ord_metodos_envio {
  id             Int      @id @default(autoincrement())
  nombre         String   @unique @db.VarChar(100)
  descripcion    String?  @db.Text
  costo          Decimal  @default(0) @db.Decimal(12, 2)
  tiempo_entrega String?  @db.VarChar(100)
  activo         Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamp

  ordenes ord_ordenes[]
}

model ord_historial_estados {
  id         Int      @id @default(autoincrement())
  orden_id   Int
  estado_id  Int
  usuario_id Int?
  fecha      DateTime @default(now()) @db.Timestamp
  notas      String?  @db.Text

  orden   ord_ordenes       @relation(fields: [orden_id], references: [id], onDelete: Cascade)
  estado  ord_estados_orden @relation("EstadoHistorial", fields: [estado_id], references: [id])
  usuario seg_usuarios?     @relation(fields: [usuario_id], references: [id])
}

model inv_stock_producto {
  id          Int      @id @default(autoincrement())
  producto_id Int      @unique
  cantidad    Int      @default(0)
  reservado   Int      @default(0)
  disponible  Int      @default(0)
  updated_at  DateTime @updatedAt @db.Timestamp

  producto cat_productos @relation(fields: [producto_id], references: [id], onDelete: Cascade)
}

model inv_movimientos_inventario {
  id          Int      @id @default(autoincrement())
  producto_id Int
  tipo        String   @db.VarChar(20) // 'entrada', 'salida', 'ajuste'
  cantidad    Int
  referencia  String?  @db.VarChar(100)
  usuario_id  Int?
  created_at  DateTime @default(now()) @db.Timestamp

  producto cat_productos @relation("MovimientosProducto", fields: [producto_id], references: [id], onDelete: Cascade, map: "inv_movimientos_inventario_producto_fkey")
  usuario  seg_usuarios? @relation(fields: [usuario_id], references: [id], map: "inv_movimientos_inventario_usuario_fkey")
}

model seg_refresh_tokens {
  id         Int      @id @default(autoincrement())
  token      String   @unique @db.VarChar(500)
  usuario_id Int
  expires_at DateTime @db.Timestamp
  revoked    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamp

  usuario seg_usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
}
